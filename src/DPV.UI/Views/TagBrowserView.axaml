<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalog="using:DPV.Domain.Contracts.Catalog"
             xmlns:viewModels="using:DPV.UI.ViewModels"
             x:Class="DPV.UI.Views.TagBrowserView"
             x:DataType="viewModels:TagBrowserViewModel">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Tags" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Discover models by genre, role, print preparation, and attributes. Click a tag to view tagged models."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBox Grid.Column="0"
                         PlaceholderText="Filter tags..."
                         Text="{Binding SearchFilter}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="catalog:TagGroupDto">
                        <Button Command="{Binding $parent[UserControl].((viewModels:TagBrowserViewModel)DataContext).SelectTagCommand}"
                                CommandParameter="{Binding Name}"
                                Margin="0,0,10,10"
                                Padding="14,10"
                                CornerRadius="16"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name, StringFormat=#{0}}"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="10"
                                        Padding="6,2">
                                    <TextBlock Text="{Binding ModelCount}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
