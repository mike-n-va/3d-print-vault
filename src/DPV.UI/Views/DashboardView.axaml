<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalog="using:DPV.Domain.Contracts.Catalog"
             xmlns:converters="using:DPV.UI.Converters"
             xmlns:viewModels="using:DPV.UI.ViewModels"
             x:DataType="viewModels:DashboardViewModel"
             x:Class="DPV.UI.Views.DashboardView">
    <UserControl.Resources>
        <converters:ThumbnailBitmapConverter x:Key="ThumbnailBitmapConverter" />
        <converters:EmptyCollectionToBoolConverter x:Key="EmptyCollectionToBoolConverter" />
    </UserControl.Resources>

    <Grid ColumnDefinitions="3*,8,2*" Margin="0">
        <!-- Master Area -->
        <DockPanel Grid.Column="0" MinWidth="450" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
                <!-- Binding contracts preserved for test assertions & accessibility -->
                <TextBlock Text="{Binding Title}" IsVisible="False" />
                <TextBlock Text="{Binding Description}" IsVisible="False" />

                <!-- Toolbar Tier 1: Folder Path & Browse -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="LibraryPathBox"
                             Grid.Column="0"
                             PlaceholderText="Library folder path"
                             Text="{Binding RootPath}"
                             VerticalAlignment="Center" />
                    <Button x:Name="BrowseFolderButton"
                            Grid.Column="1"
                            Content="Browse"
                            Click="BrowseFolderClick"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Toolbar Tier 2: Import, Cancel, Progress, Status -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <Button x:Name="ImportButton"
                            Grid.Column="0"
                            Content="Import"
                            Classes="accent"
                            Command="{Binding ImportCommand}"
                            VerticalAlignment="Center" />
                    <Button x:Name="CancelImportButton"
                            Grid.Column="1"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            VerticalAlignment="Center" />
                    <ProgressBar x:Name="ImportProgressBar"
                                 Grid.Column="2"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercentage}"
                                 IsIndeterminate="{Binding IsScanning}"
                                 Height="4"
                                 VerticalAlignment="Center" />
                    <TextBlock x:Name="ImportStatusText"
                               Grid.Column="3"
                               Text="{Binding CurrentStatusText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Dedicated Filter Bar: Search Box and Tag Filter -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             PlaceholderText="Search models"
                             Text="{Binding SearchQuery}" />
                    <ComboBox x:Name="TagFilterBox"
                              Grid.Column="1"
                              MinWidth="140"
                              ItemsSource="{Binding TagFilterChoices}"
                              SelectedItem="{Binding TagFilter}"
                              PlaceholderText="All tags" />
                </Grid>
            </StackPanel>

            <!-- Master Content: Model List or Catalog Empty State -->
            <Grid>
                <!-- Catalog List -->
                <ListBox x:Name="ModelList"
                         ItemsSource="{Binding Models}"
                         SelectedItem="{Binding SelectedModel}"
                         IsVisible="{Binding Models.Count, Converter={StaticResource EmptyCollectionToBoolConverter}, ConverterParameter=invert}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="catalog:ModelSummaryDto">
                            <Grid ColumnDefinitions="48,*" ColumnSpacing="10" Margin="0,4">
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="4"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        ClipToBounds="True">
                                    <Image Stretch="Uniform"
                                           Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailBitmapConverter}}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FilePath}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Catalog Empty State -->
                <Border IsVisible="{Binding Models.Count, Converter={StaticResource EmptyCollectionToBoolConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Border Width="56"
                                Height="56"
                                CornerRadius="12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <TextBlock Text="3D"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No Models Found"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Select a library folder and start an import to populate your vault."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="280"
                                   HorizontalAlignment="Center" />
                        <Button Content="Browse Folder..."
                                Click="BrowseFolderClick"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- Column 1: GridSplitter -->
        <GridSplitter x:Name="CatalogGridSplitter"
                      Grid.Column="1"
                      Width="4"
                      Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                      HorizontalAlignment="Center" />

        <!-- Column 2: Inspector Panel -->
        <Border x:Name="InspectorPanel"
                Grid.Column="2"
                MinWidth="320"
                MaxWidth="480"
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="Model Inspector" FontSize="18" FontWeight="SemiBold" />

                    <!-- Inspector Empty State -->
                    <Border IsVisible="{Binding !HasSelectedModel}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="16"
                            Margin="0,32,0,0">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Border Width="56"
                                    Height="56"
                                    CornerRadius="12"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="3D"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No Model Selected"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Select a model from the library to inspect its files, 3D preview, and metadata."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="240"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Inspector Populated State -->
                    <StackPanel Spacing="12" IsVisible="{Binding HasSelectedModel}">
                        <Border Height="180"
                                CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Image Stretch="Uniform"
                                   Source="{Binding PreviewPath, Converter={StaticResource ThumbnailBitmapConverter}}" />
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Model name" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding DetailedModel.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Artist" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBox PlaceholderText="Artist name"
                                     Text="{Binding ArtistDraft}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Collection" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBox PlaceholderText="Collection name"
                                     Text="{Binding CollectionDraft}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Tags" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBox PlaceholderText="miniature, supported, monster"
                                     Text="{Binding TagsDraft}" />
                        </StackPanel>
                        <Button x:Name="SaveMetadataButton"
                                Content="Save metadata"
                                Classes="accent"
                                Command="{Binding SaveMetadataCommand}"
                                HorizontalAlignment="Stretch" />
                        <TextBlock Text="Associated files" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding DetailedModel.Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="catalog:ModelFileDto">
                                    <StackPanel Spacing="2" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding FileHash}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
