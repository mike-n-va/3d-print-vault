<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalog="using:DPV.Domain.Contracts.Catalog"
             xmlns:converters="using:DPV.UI.Converters"
             xmlns:viewModels="using:DPV.UI.ViewModels"
             x:Class="DPV.UI.Views.ReleaseBrowserView"
             x:DataType="viewModels:ReleaseBrowserViewModel">
    <UserControl.Resources>
        <converters:ThumbnailBitmapConverter x:Key="ThumbnailBitmapConverter" />
        <converters:FavoriteIconConverter x:Key="FavoriteIconConverter" />
        <converters:FavoriteBrushConverter x:Key="FavoriteBrushConverter" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Releases &amp; Sets" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Browse your 3D model library organized by creator releases, campaign sets, and themes."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBox Grid.Column="0"
                         PlaceholderText="Filter releases by name, creator, or description..."
                         Text="{Binding SearchFilter}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </StackPanel>

        <!-- 16:9 Hero Card Grid (S7-005, S7-006) -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Releases}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="catalog:ReleaseSummaryDto">
                        <Border Margin="0,0,16,16"
                                Width="320"
                                CornerRadius="10"
                                ClipToBounds="True"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="180,Auto">
                                <!-- 16:9 Hero Banner with Click to Navigate -->
                                <Button Grid.Row="0"
                                        Padding="0"
                                        Background="#1E232A"
                                        CornerRadius="10,10,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((viewModels:ReleaseBrowserViewModel)DataContext).SelectReleaseCommand}"
                                        CommandParameter="{Binding}">
                                    <Panel>
                                        <!-- Cover Image -->
                                        <Image Source="{Binding CoverImagePath, Converter={StaticResource ThumbnailBitmapConverter}}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                        <!-- Top Left: Model Count Badge -->
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="10"
                                                Background="#CC111827"
                                                CornerRadius="6"
                                                Padding="8,4">
                                            <TextBlock Text="{Binding ModelCount, StringFormat='{}{0} Models'}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#F3F4F6" />
                                        </Border>

                                        <!-- Top Right: Favorite Button -->
                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="6,4"
                                                Background="#B017212B"
                                                CornerRadius="6"
                                                Command="{Binding $parent[UserControl].((viewModels:ReleaseBrowserViewModel)DataContext).ToggleFavoriteCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Toggle Release Favorite">
                                            <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                                       Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteBrushConverter}}"
                                                       FontSize="13" />
                                        </Button>
                                    </Panel>
                                </Button>

                                <!-- Card Metadata Footer -->
                                <Border Grid.Row="1" Padding="14,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="4">
                                        <!-- Release Name -->
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Artist & Date Row -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ArtistName, StringFormat='by {0}'}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ReleaseDate}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="11" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
