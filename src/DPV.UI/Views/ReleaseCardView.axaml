<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:DPV.UI.Converters"
             xmlns:viewModels="using:DPV.UI.ViewModels"
             x:Class="DPV.UI.Views.ReleaseCardView"
             x:DataType="viewModels:ReleaseCardViewModel">
    <UserControl.Resources>
        <converters:ThumbnailBitmapConverter x:Key="ThumbnailBitmapConverter" />
        <converters:FavoriteIconConverter x:Key="FavoriteIconConverter" />
        <converters:FavoriteBrushConverter x:Key="FavoriteBrushConverter" />
        <converters:InitialsConverter x:Key="InitialsConverter" />
    </UserControl.Resources>

    <Border Width="320"
            CornerRadius="10"
            ClipToBounds="True"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid RowDefinitions="180,Auto">
            <!-- 16:9 Widescreen Hero Banner (320x180) -->
            <Button Grid.Row="0"
                    Padding="0"
                    Background="#18181B"
                    CornerRadius="9,9,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding SelectCommand}">
                <Panel Width="318" Height="180" ClipToBounds="True">
                    <!-- Banner Cover Image -->
                    <Image Source="{Binding BannerPath, Converter={StaticResource ThumbnailBitmapConverter}}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                    <!-- Fallback Icon if missing -->
                    <TextBlock Text="CAMPAIGN / RELEASE"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#52525B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding BannerPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

                    <!-- Top Left: Model Count Badge -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Background="#CC111827"
                            CornerRadius="6"
                            Padding="8,4">
                        <TextBlock Text="{Binding ModelCount, StringFormat='{}{0} Models'}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#F3F4F6" />
                    </Border>

                    <!-- Top Right: Favorite Button -->
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8"
                            Padding="6,4"
                            Background="#B017212B"
                            CornerRadius="6"
                            Command="{Binding ToggleFavoriteCommand}"
                            ToolTip.Tip="Toggle Release Favorite">
                        <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                   Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteBrushConverter}}"
                                   FontSize="13" />
                    </Button>
                </Panel>
            </Button>

            <!-- Card Lower Metadata -->
            <Border Grid.Row="1" Padding="14,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <!-- Release Title -->
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}" />

                    <!-- Studio / Creator Badge -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Border Grid.Column="0"
                                Width="22"
                                Height="22"
                                CornerRadius="11"
                                Background="#27272A"
                                BorderBrush="#3F3F46"
                                BorderThickness="1">
                            <TextBlock Text="{Binding ArtistName, Converter={StaticResource InitialsConverter}}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#A1A1AA"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ArtistName, FallbackValue='Independent Studio'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Description Preview -->
                    <TextBlock Text="{Binding Description}"
                               FontSize="11"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
