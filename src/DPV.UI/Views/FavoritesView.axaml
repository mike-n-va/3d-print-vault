<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalog="using:DPV.Domain.Contracts.Catalog"
             xmlns:converters="using:DPV.UI.Converters"
             xmlns:viewModels="using:DPV.UI.ViewModels"
             x:Class="DPV.UI.Views.FavoritesView"
             x:DataType="viewModels:FavoritesViewModel">
    <UserControl.Resources>
        <converters:ThumbnailBitmapConverter x:Key="ThumbnailBitmapConverter" />
        <converters:FavoriteIconConverter x:Key="FavoriteIconConverter" />
        <converters:FavoriteBrushConverter x:Key="FavoriteBrushConverter" />
        <converters:InitialsConverter x:Key="InitialsConverter" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- Header & Category Switcher (S7-012) -->
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <TextBlock Text="Favorites &amp; Curation" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Your bookmarked models, campaign sets, and favorite creator studios."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Sub-tabs: Models | Releases | Artists -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Content="{Binding ModelsCount, StringFormat='Models ({0})'}"
                        Padding="14,8"
                        FontWeight="SemiBold"
                        Command="{Binding SelectCategoryModelsCommand}" />
                <Button Content="{Binding ReleasesCount, StringFormat='Releases &amp; Sets ({0})'}"
                        Padding="14,8"
                        FontWeight="SemiBold"
                        Command="{Binding SelectCategoryReleasesCommand}" />
                <Button Content="{Binding ArtistsCount, StringFormat='Artists ({0})'}"
                        Padding="14,8"
                        FontWeight="SemiBold"
                        Command="{Binding SelectCategoryArtistsCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Main Scrollable Content -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Panel>
                <!-- CATEGORY 1: FAVORITE MODELS -->
                <ItemsControl ItemsSource="{Binding FavoriteModels}" IsVisible="{Binding IsModelsSelected}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="catalog:ModelSummaryDto">
                            <Border Margin="0,0,12,12"
                                    Width="200"
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowDefinitions="150,Auto">
                                    <Button Grid.Row="0"
                                            Padding="0"
                                            Background="#1E232A"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Command="{Binding $parent[UserControl].((viewModels:FavoritesViewModel)DataContext).SelectModelCommand}"
                                            CommandParameter="{Binding}">
                                        <Panel>
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailBitmapConverter}}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <Button HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="6"
                                                    Padding="4,2"
                                                    Background="#B017212B"
                                                    CornerRadius="4"
                                                    Command="{Binding $parent[UserControl].((viewModels:FavoritesViewModel)DataContext).ToggleModelFavoriteCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="♥" Foreground="#FF4757" FontSize="12" />
                                            </Button>
                                        </Panel>
                                    </Button>

                                    <Border Grid.Row="1" Padding="10,8">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ArtistName}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CATEGORY 2: FAVORITE RELEASES -->
                <ItemsControl ItemsSource="{Binding FavoriteReleases}" IsVisible="{Binding IsReleasesSelected}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="catalog:ReleaseSummaryDto">
                            <Border Margin="0,0,16,16"
                                    Width="320"
                                    CornerRadius="10"
                                    ClipToBounds="True"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowDefinitions="180,Auto">
                                    <Button Grid.Row="0"
                                            Padding="0"
                                            Background="#1E232A"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Command="{Binding $parent[UserControl].((viewModels:FavoritesViewModel)DataContext).SelectReleaseCommand}"
                                            CommandParameter="{Binding}">
                                        <Panel>
                                            <Image Source="{Binding CoverImagePath, Converter={StaticResource ThumbnailBitmapConverter}}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="8"
                                                    Background="#CC111827"
                                                    CornerRadius="6"
                                                    Padding="6,3">
                                                <TextBlock Text="{Binding ModelCount, StringFormat='{}{0} Models'}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#F3F4F6" />
                                            </Border>
                                            <Button HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="6"
                                                    Padding="6,4"
                                                    Background="#B017212B"
                                                    CornerRadius="6"
                                                    Command="{Binding $parent[UserControl].((viewModels:FavoritesViewModel)DataContext).ToggleReleaseFavoriteCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="♥" Foreground="#FF4757" FontSize="13" />
                                            </Button>
                                        </Panel>
                                    </Button>

                                    <Border Grid.Row="1" Padding="14,12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ArtistName, StringFormat='by {0}'}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CATEGORY 3: FAVORITE ARTISTS -->
                <ItemsControl ItemsSource="{Binding FavoriteArtists}" IsVisible="{Binding IsArtistsSelected}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="catalog:ArtistGroupDto">
                            <Button Command="{Binding $parent[UserControl].((viewModels:FavoritesViewModel)DataContext).SelectArtistCommand}"
                                    CommandParameter="{Binding Name}"
                                    Margin="0,0,12,12"
                                    Padding="16,14"
                                    CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Width="240">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ModelCount, StringFormat={}{0} models}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Padding="4"
                                            Background="Transparent"
                                            Command="{Binding $parent[UserControl].((viewModels:FavoritesViewModel)DataContext).ToggleArtistFavoriteCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="♥" Foreground="#FF4757" FontSize="13" />
                                    </Button>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
